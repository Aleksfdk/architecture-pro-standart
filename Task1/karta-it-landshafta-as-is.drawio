        <mxCell id="53" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;Обращение по депозиту уходит в АБС.&lt;br&gt;Платформу поддерживает подрядчик,&lt;br&gt;точечно могут править Java-специалисты&lt;br&gt;команды АБС" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="562" y="747" width="264" height="99" as="geometry"/></mxCell>
        <mxCell id="54" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="834" y="741" width="280" height="119" as="geometry"/></mxCell>
        <mxCell id="55" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1114" y="741" width="280" height="119" as="geometry"/></mxCell>
        <mxCell id="56" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1394" y="741" width="280" height="119" as="geometry"/></mxCell>
        <mxCell id="57" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1674" y="741" width="280" height="119" as="geometry"/></mxCell>
        <mxCell id="58" value="&lt;b&gt;Партнёрский кол-центр&lt;/b&gt;&lt;br&gt;100 человек · внешняя компания" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#d0d5dd;fontSize=12;fontFamily=Arial;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="24" y="860" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="59" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="274" y="860" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="60" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="554" y="860" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="61" value="&lt;b&gt;Система партнёрского КЦ&lt;/b&gt;&lt;br&gt;Внешняя. Скрипты вручную. С АБС не&lt;br&gt;связана" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="562" y="866" width="264" height="65" as="geometry"/></mxCell>
        <mxCell id="62" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="834" y="860" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="63" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1114" y="860" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="64" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1394" y="860" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="65" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1674" y="860" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="66" value="&lt;b&gt;Управление IT&lt;/b&gt;&lt;br&gt;Интернет-банк 10 + 10 подрядчик · АБС&lt;br&gt;20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#d0d5dd;fontSize=12;fontFamily=Arial;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="24" y="945" width="250" height="189" as="geometry"/></mxCell>
        <mxCell id="67" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="274" y="945" width="280" height="189" as="geometry"/></mxCell>
        <mxCell id="68" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="554" y="945" width="280" height="189" as="geometry"/></mxCell>
        <mxCell id="69" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="834" y="945" width="280" height="189" as="geometry"/></mxCell>
        <mxCell id="70" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;Сопровождает IT. Отправка через&lt;br&gt;телеком-оператора" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="842" y="951" width="264" height="65" as="geometry"/></mxCell>
        <mxCell id="71" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1114" y="945" width="280" height="189" as="geometry"/></mxCell>
        <mxCell id="72" value="&lt;b&gt;Разрыв&lt;/b&gt;&lt;br&gt;Ставок в системах нет. Интернет-банк&lt;br&gt;депозит не открывает" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#e6a700;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1122" y="951" width="264" height="65" as="geometry"/></mxCell>
        <mxCell id="73" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1394" y="945" width="280" height="189" as="geometry"/></mxCell>
        <mxCell id="74" value="&lt;b&gt;Кредитный скоринг&lt;/b&gt;&lt;br&gt;Python, Flask, PostgreSQL. Разработка IT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1402" y="951" width="264" height="48" as="geometry"/></mxCell>
        <mxCell id="75" value="&lt;b&gt;Кредитный конвейер&lt;/b&gt;&lt;br&gt;Java и BPMN: IT и подрядчик внедрения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1402" y="1003" width="264" height="48" as="geometry"/></mxCell>
        <mxCell id="76" value="&lt;b&gt;БКИ&lt;/b&gt;&lt;br&gt;Внешний REST, источник данных&lt;br&gt;скоринга" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1402" y="1055" width="264" height="65" as="geometry"/></mxCell>
        <mxCell id="77" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e5e7eb;fontSize=11;fontFamily=Arial;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1674" y="945" width="280" height="189" as="geometry"/></mxCell>
        <mxCell id="78" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;Delphi, Oracle, PL/SQL. Своя разработка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1682" y="951" width="264" height="48" as="geometry"/></mxCell>
        <mxCell id="79" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;Платежи и текущие счета. Прямой доступ&lt;br&gt;к БД АБС" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#1565c0;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1682" y="1003" width="264" height="65" as="geometry"/></mxCell>
        <mxCell id="80" value="&lt;b&gt;Команда цифровой трансформации&lt;/b&gt;&lt;br&gt;розничного бизнеса&lt;br&gt;10 человек" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="24" y="1134" width="250" height="73" as="geometry"/></mxCell>
        <mxCell id="81" value="&lt;b&gt;Своих систем нет. Онлайн-продажи депозитов и кредитов не на чем строить: интернет-банк эти продукты не содержит, сайт заявки не принимает.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontSize=13;fontFamily=Arial;fontColor=#7a4f01;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="274" y="1134" width="1680" height="73" as="geometry"/></mxCell>
        <mxCell id="82" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;Синий — АБС и интернет-банк. Фиолетовый — кол-центр. Красный — Excel и почта, ручной контур. Оранжевый — кредитный конвейер. Зелёный — скоринг. Серый пунктир — внешняя система. Жёлтый пунктир — разрыв: возможность есть, приложения нет. Пустая ячейка — подразделение возможность не выполняет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d5dd;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="24" y="1223" width="1930" height="56" as="geometry"/></mxCell>
        <mxCell id="83" value="&lt;b&gt;Сайт вне матрицы&lt;/b&gt;&lt;br&gt;Сайт на PHP и React.js — своя разработка банка. Он показывает маркетинговую информацию и не&lt;br&gt;закрывает ни одну возможность 2-го уровня: ни продажи, ни депозиты, ни кредиты, ни договоры." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0e6;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="24" y="1291" width="638" height="107" as="geometry"/></mxCell>
        <mxCell id="84" value="&lt;b&gt;Почему депозит не мгновенный&lt;/b&gt;&lt;br&gt;Ставку каждый день считают в Excel в кредитном бэк-офисе и отправляют почтой. Спецставка — отдельные&lt;br&gt;письма: депозитный и кредитный контуры не видят данные друг друга. Клиент ждёт в отделении около 20&lt;br&gt;минут, при спецставке до часа. Интернет-банк к ставке и открытию депозита не подключён." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0e6;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="670" y="1291" width="638" height="107" as="geometry"/></mxCell>
        <mxCell id="85" value="&lt;b&gt;Как на карте отражён кредит&lt;/b&gt;&lt;br&gt;Заявку создаёт фронт-офис в АБС. Дальше работают кредитный конвейер Camunda, скоринг и бюро&lt;br&gt;кредитных историй. Обмен заявки и решения с АБС идёт по базе раз в сутки, поэтому решения в день&lt;br&gt;обращения ландшафт не даёт. В бюро скоринг ходит сразу, клиентские данные и платежи забирает&lt;br&gt;пакетом." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0e6;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1316" y="1291" width="638" height="107" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
