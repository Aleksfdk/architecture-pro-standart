<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0" type="device">
  <diagram id="Схема интеграции as-is" name="Схема интеграции as-is">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b&gt;Схема интеграции приложений as-is · банк «Стандарт»&lt;/b&gt;&lt;br&gt;Участники указаны в карточках систем. Ниже — те же потоки в порядке процессов депозита и кредита." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=16;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="2200" height="48" as="geometry"/></mxCell>
        <mxCell id="3" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;PHP, React.js. Своя разработка&lt;br&gt;Участник: клиент&lt;br&gt;Только маркетинговая информация&lt;br&gt;С другими системами не связан" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="4" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;React, Java Spring Boot, PostgreSQL&lt;br&gt;Микросервисы. Инфраструктура банка, поддерживает&lt;br&gt;подрядчик&lt;br&gt;Участник: оператор кол-центра&lt;br&gt;Регистрирует обращение по депозиту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="75" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="5" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;ASP.NET MVC 4.5, .NET Framework 4.5, MS SQL&lt;br&gt;Монолит подрядчика, есть резервный ЦОД&lt;br&gt;Участник: клиент&lt;br&gt;Платежи и текущие счета&lt;br&gt;Депозитов и кредитов нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#1565c0;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="370" height="185" as="geometry"/></mxCell>
        <mxCell id="6" value="&lt;b&gt;Телеком-оператор&lt;/b&gt;&lt;br&gt;Внешняя компания&lt;br&gt;Доставляет SMS клиенту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="7" value="&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt;&lt;br&gt;Внешняя система другой компании, не подрядчик кол-центра&lt;br&gt;банка&lt;br&gt;Участники: оператор партнёра, бизнес-представитель банка&lt;br&gt;Звонки по скриптам. Скрипты передают вручную&lt;br&gt;С АБС и системой кол-центра банка не связана" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1580" y="70" width="400" height="185" as="geometry"/></mxCell>
        <mxCell id="8" value="&lt;b&gt;Excel и почта&lt;/b&gt;&lt;br&gt;Ручной контур, не информационная система&lt;br&gt;Участники: кредитный бэк-офис, депозитный&lt;br&gt;бэк-офис, сотрудник отделения&lt;br&gt;Ежедневный файл ставок и спецставки&lt;br&gt;Контуры не видят данные друг друга, поэтому&lt;br&gt;обмен письмами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="310" height="230" as="geometry"/></mxCell>
        <mxCell id="9" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;Десктоп на Delphi, СУБД Oracle, логика на PL/SQL&lt;br&gt;Своя разработка, команда 20 человек&lt;br&gt;Участники: фронт-офис, депозитный бэк-офис, кредитный бэк-офис&lt;br&gt;Учёт операций, бухгалтерия, договоры, платежи&lt;br&gt;Заявки на депозит и кредит, запуск SMS о ставке" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="360" width="560" height="270" as="geometry"/></mxCell>
        <mxCell id="10" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;Сопровождает IT банка&lt;br&gt;Принимает команду от АБС&lt;br&gt;Передаёт сообщение телеком-оператору" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1220" y="400" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="11" value="&lt;b&gt;Кредитный конвейер&lt;/b&gt;&lt;br&gt;Camunda, Oracle, обработчики на Java&lt;br&gt;Коробка. Дорабатывают подрядчик внедрения и IT&lt;br&gt;Участник: менеджер кредитования&lt;br&gt;Изучает заявку и принимает решение о выдаче" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="760" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="12" value="&lt;b&gt;Кредитный скоринг&lt;/b&gt;&lt;br&gt;Python, REST на Flask, PostgreSQL&lt;br&gt;Своя разработка IT. Внутренняя ML-модель&lt;br&gt;Вызывается из конвейера по API&lt;br&gt;Источники: АБС, конвейер, бюро" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1720" y="760" width="320" height="185" as="geometry"/></mxCell>
        <mxCell id="13" value="&lt;b&gt;Бюро кредитных историй&lt;/b&gt;&lt;br&gt;Внешняя система&lt;br&gt;REST API&lt;br&gt;Запрос в момент скоринга, не пакетом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="2180" y="775" width="270" height="155" as="geometry"/></mxCell>
        <mxCell id="26" value="&lt;b&gt;Как читать стрелки&lt;/b&gt;&lt;br&gt;Синяя — прямой доступ к базе. Серая — передача между системами, протокол в описании не задан. Оранжевая — пакет по базе раз в сутки. Зелёная — онлайн API или REST. Красный пунктир — человек переносит данные через Excel или почту. Сайт и партнёрский кол-центр без стрелок: интеграций с банковскими системами у них нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d5dd;fontSize=13;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="2340" height="60" as="geometry"/></mxCell>
        <mxCell id="27" value="&lt;b&gt;Процесс открытия депозита&lt;/b&gt;&lt;br&gt;1. Кредитный бэк-офис каждый день считает ставку в Excel: ставка рефинансирования ЦБ, объём выданных кредитов и депозитов, кредитный риск банка. Файл уходит почтой&lt;br&gt;депозитному бэк-офису.&lt;br&gt;2. Если клиент сначала позвонил, оператор кол-центра заводит обращение в своей системе. Обращение передаётся в АБС. В саму АБС оператор не входит.&lt;br&gt;3. Депозитный бэк-офис обрабатывает обращение в АБС и фиксирует ставку. АБС отправляет клиенту SMS через шлюз и телеком-оператора: депозит можно получить в отделении&lt;br&gt;по этой ставке.&lt;br&gt;4. Если клиент пришёл без звонка, сотрудник отделения пишет письмо депозитному бэк-офису. Пока идёт согласование, клиент ждёт в отделении, обычно около 20 минут.&lt;br&gt;5. Спецставка для клиента с крупным остатком: депозитный бэк-офис запрашивает кредитный. Сотрудник кредитования смотрит риск этого клиента в своём разделе АБС и отвечает&lt;br&gt;письмом. Депозитный менеджер добавляет данные в Excel, считает ставку и отправляет её письмом в отделение. Так до часа.&lt;br&gt;6. Сотрудник отделения создаёт депозит в АБС, отдаёт документы и после подписи загружает их в АБС.&lt;br&gt;Партнёрский кол-центр в контур не входит: другая компания, другая система, скрипты от бизнес-представителей банка, связи с АБС нет. Сайт и интернет-банк заявку на депозит не&lt;br&gt;принимают." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0e6;fontSize=13;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="1078" width="1160" height="242" as="geometry"/></mxCell>
        <mxCell id="28" value="&lt;b&gt;Процесс открытия кредита&lt;/b&gt;&lt;br&gt;1. Заявку можно подать только в отделении. Сотрудник фронт-офиса создаёт её в АБС и говорит клиенту, что банк её рассмотрит.&lt;br&gt;2. Раз в сутки заявки уходят из АБС в кредитный конвейер интеграцией по базе.&lt;br&gt;3. Менеджер кредитования работает в конвейере на Camunda. В ходе разбора конвейер вызывает скоринг по API.&lt;br&gt;4. Скоринг в этот момент онлайн запрашивает бюро кредитных историй по REST. Данные клиентов и история платежей лежат в АБС, номера платежей к договору — в конвейере. В&lt;br&gt;скоринг эти данные попадают из баз других систем раз в сутки, не в секунду заявки.&lt;br&gt;5. Решение о выдаче принимает сотрудник: по оценке скоринга и параметрам заявки.&lt;br&gt;6. После одобрения заявка получает финальный статус. Раз в сутки статус возвращается в АБС, и АБС проводит зачисление кредитных средств на счёт клиента.&lt;br&gt;Интернет-банк здесь не участвует. С АБС он связан только прямым доступом к базе и только для платежей и текущих счетов. Из-за суточных пакетов решение за один день текущая&lt;br&gt;схема не обеспечивает, даже если данных для скоринга достаточно." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5d0e6;fontSize=13;fontFamily=Arial;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;spacingBottom=4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1210" y="1078" width="1160" height="242" as="geometry"/></mxCell>
        <mxCell id="14" value="Прямой доступ к БД" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#1565c0;strokeWidth=2;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9196428571428571;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="15" value="Передача обращения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.19642857142857142;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="16" value="ставка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontColor=#222222;dashed=1;dashPattern=6 4;exitX=1;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.28;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="17" value="риск" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;fontColor=#222222;dashed=1;dashPattern=6 4;exitX=0;exitY=0.62;exitDx=0;exitDy=0;entryX=1;entryY=0.68;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="18" value="SMS о ставке" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#222222;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="19" value="SMS клиенту" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="20" value="Заявки · БД · 1 раз в сутки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#222222;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.22;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="609" y="700"/><mxPoint x="1168" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="21" value="Статус · БД · 1 раз в сутки, затем зачисление" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#222222;exitX=0.78;exitY=0;exitDx=0;exitDy=0;entryX=0.78;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1392" y="745"/><mxPoint x="867" y="745"/></Array></mxGeometry></mxCell>
        <mxCell id="22" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;strokeWidth=2;fontColor=#222222;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.28;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="23" value="номера платежей, пакет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#222222;exitX=1;exitY=0.72;exitDx=0;exitDy=0;entryX=0;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="24" value="REST онлайн" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;strokeWidth=2;fontColor=#222222;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="25" value="Клиенты и платежи · БД · 1 раз в сутки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontFamily=Arial;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#222222;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.28;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1816" y="590"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
