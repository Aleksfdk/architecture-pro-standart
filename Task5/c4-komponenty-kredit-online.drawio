<mxCell id="ad" value="&lt;b&gt;Java-адаптер&lt;/b&gt;&lt;br&gt;[компонент]&lt;br&gt;Поток в Oracle ограничен.&lt;br&gt;Не суточный файл" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=4;fontSize=13;fontColor=#111827;fillColor=#ffffff;strokeColor=#1168bd;" vertex="1" parent="1"><mxGeometry x="620" y="830" width="200" height="140" as="geometry"/></mxCell>
