<mxCell id="pub" value="&lt;b&gt;Публикация в АБС&lt;/b&gt;&lt;br&gt;[обработчик Java]&lt;br&gt;Карточка в тот же день. Паспорт в базу не пишется" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=4;fontSize=13;fontColor=#111827;fillColor=#ffffff;strokeColor=#1168bd;" vertex="1" parent="1"><mxGeometry x="620" y="530" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="saved" value="&lt;b&gt;Уже посчитанный результат&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;Без ночного пересчёта клиентов" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=4;fontSize=13;fontColor=#111827;fillColor=#ffffff;strokeColor=#0f4c81;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="145" width="360" height="120" as="geometry"/></mxCell>
