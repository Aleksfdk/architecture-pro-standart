<mxCell id="terms" value="&lt;b&gt;Условия продукта&lt;/b&gt;&lt;br&gt;[компонент]&lt;br&gt;Источник каталога. Сайт копию не ведёт" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=4;fontSize=13;fontColor=#111827;fillColor=#ffffff;strokeColor=#1168bd;" vertex="1" parent="1"><mxGeometry x="620" y="145" width="420" height="100" as="geometry"/></mxCell>
