  <diagram id="C4 контекст. Передача ставок" name="C4 контекст. Передача ставок">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;C4. Контекст. Передача ставок в кол-центры&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontColor=#111827;fontSize=20;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="1500" height="36" as="geometry"/></mxCell>
<mxCell id="bo" value="&lt;b&gt;Депозитный бэк-офис&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="280" height="68" as="geometry"/></mxCell>
<mxCell id="client" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1540" y="70" width="240" height="68" as="geometry"/></mxCell>
<mxCell id="abs" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;[система, Delphi, Oracle]&lt;br&gt;Сетка ставок в своём разделе" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#1168bd;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="300" height="140" as="geometry"/></mxCell>
<mxCell id="svc" value="&lt;b&gt;Сервис открытия депозитов&lt;/b&gt;&lt;br&gt;[система, ASP.NET Core]&lt;br&gt;Витрина базовых ставок" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#0f4c81;strokeColor=#0b3a66;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="420" height="180" as="geometry"/></mxCell>
<mxCell id="cc" value="&lt;b&gt;Система кол-центра банка&lt;/b&gt;&lt;br&gt;[система, Java]&lt;br&gt;Карточка текущих ставок" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#1168bd;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="200" width="360" height="150" as="geometry"/></mxCell>
<mxCell id="opb" value="&lt;b&gt;Оператор банка&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1540" y="240" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="sftp" value="&lt;b&gt;SFTP банка&lt;/b&gt;&lt;br&gt;[система, IT банка]&lt;br&gt;Каталог файла ставок" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#1168bd;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="340" height="130" as="geometry"/></mxCell>
<mxCell id="partner" value="&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt;&lt;br&gt;[внешняя система]&lt;br&gt;Ставки из файла, API банка нет" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#6b7280;strokeColor=#4b5563;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="480" width="400" height="160" as="geometry"/></mxCell>
<mxCell id="opp" value="&lt;b&gt;Оператор партнёра&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1540" y="520" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="note" value="&lt;b&gt;Как читать схему&lt;/b&gt;&lt;br&gt;На схеме только передача текущих ставок. Заявки, СМС и открытие депозита здесь не показаны.&lt;br&gt;Сайт и интернет-банк уже читают ту же витрину. Этот кейс их не меняет.&lt;br&gt;Кол-центр банка запрашивает каталог у сервиса по HTTPS и в АБС не ходит.&lt;br&gt;Партнёр внешний. Он забирает файл со SFTP и API сервиса не вызывает.&lt;br&gt;В карточке и в файле только публичный каталог и время среза. Персональной ставки и данных клиента там нет.&lt;br&gt;Кредитный бэк-офис задаёт риск в своём разделе АБС. В файл для партнёра этот раздел не попадает.&lt;br&gt;Ставка на экране — предложение, пока депозитный бэк-офис не подтвердит её в АБС." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fillColor=#f8fafc;strokeColor=#d0d5dd;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1800" height="230" as="geometry"/></mxCell>
<mxCell id="e1" value="Сетка в своём разделе" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#083f75;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bo" target="abs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
