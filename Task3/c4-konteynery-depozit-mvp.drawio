<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0" type="device">
  <diagram id="C4 контейнеры. MVP открытия депозитов" name="C4 контейнеры. MVP открытия депозитов">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2140" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b&gt;C4. Контейнеры. MVP открытия депозитов. Детализированы интернет-банк и АБС&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontColor=#111827;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1700" height="30" as="geometry"/></mxCell>
        <mxCell id="3" value="&lt;b&gt;Интернет-банк  [граница системы]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#1168bd;fontColor=#0d47a1;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;spacing=6;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="24" y="150" width="1120" height="620" as="geometry"/></mxCell>
        <mxCell id="4" value="&lt;b&gt;АБС  [граница системы]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#1168bd;fontColor=#0d47a1;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;spacing=6;arcSize=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1480" y="150" width="630" height="620" as="geometry"/></mxCell>
        <mxCell id="5" value="&lt;b&gt;Сайт  [PHP, React.js]&lt;/b&gt;&lt;br&gt;Каталог и заявка нового клиента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="6" value="&lt;b&gt;Веб-приложение&lt;/b&gt;&lt;br&gt;[ASP.NET MVC 4.5]&lt;br&gt;Страницы депозитов.&lt;br&gt;Делает команда банка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="7" value="&lt;b&gt;Ядро монолита&lt;/b&gt;&lt;br&gt;[.NET Framework 4.5]&lt;br&gt;Платежи и старый модуль СМС.&lt;br&gt;В этом MVP не меняется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#9ca3af;fontColor=#374151;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="8" value="&lt;b&gt;MS SQL интернет-банка&lt;/b&gt;&lt;br&gt;Платежи и счета" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f3f4f6;strokeColor=#9ca3af;fontColor=#374151;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="540" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="9" value="&lt;b&gt;Сервис открытия депозитов&lt;/b&gt;&lt;br&gt;[ASP.NET Core]&lt;br&gt;Каталог, заявки, СМС-код.&lt;br&gt;АБС напрямую не вызывает" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f4c81;strokeColor=#0b3a66;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="10" value="&lt;b&gt;MS SQL сервиса&lt;/b&gt;&lt;br&gt;Заявки, витрина ставок,&lt;br&gt;статусы и коды" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="11" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;[Java, Spring Boot]&lt;br&gt;Лид и особые условия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="24" y="820" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="12" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;Код и СМС о статусе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="820" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="13" value="&lt;b&gt;Телеком-оператор&lt;/b&gt;&lt;br&gt;[внешняя система]&lt;br&gt;Доставка СМС" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="820" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="14" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;Темы заявок,&lt;br&gt;ставок и статусов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5b21b6;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1200" y="220" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="15" value="&lt;b&gt;Адаптер АБС&lt;/b&gt;&lt;br&gt;[Java]&lt;br&gt;Outbox и вызов процедур.&lt;br&gt;Поток в Oracle ограничен" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f4c81;strokeColor=#0b3a66;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1520" y="210" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="16" value="&lt;b&gt;Oracle АБС&lt;/b&gt;&lt;br&gt;Учёт и outbox.&lt;br&gt;Каналам закрыта" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="430" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="17" value="&lt;b&gt;Клиент АБС&lt;/b&gt;&lt;br&gt;[Delphi]&lt;br&gt;Заявки, ставки,&lt;br&gt;идентификация" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1840" y="210" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="18" value="&lt;b&gt;Логика депозитов&lt;/b&gt;&lt;br&gt;[PL/SQL]&lt;br&gt;Ставки, подтверждение,&lt;br&gt;права двух бэк-офисов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3c7fc0;strokeColor=#255a8a;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1820" y="420" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="19" value="&lt;b&gt;Покрытие сценариев&lt;/b&gt;&lt;br&gt;UC1. Сайт отдаёт каталог и заявку в сервис. Сервис передаёт лид в кол-центр.&lt;br&gt;UC2. Запрос особой ставки идёт из кол-центра в сервис, затем в Kafka и адаптер. Ответ возвращается в кол-центр.&lt;br&gt;UC3. Сотрудники работают в клиенте АБС. Подтверждение выполняет PL/SQL. Статус через Kafka попадает в сервис, сервис шлёт СМС.&lt;br&gt;UC4. Веб-приложение читает ставку у сервиса. СМС-код уходит из сервиса в шлюз, не из ядра монолита.&lt;br&gt;UC5. Бэк-офисы ведут ставки в своих разделах АБС. PL/SQL кладёт их в outbox. Каналы читают витрину сервиса.&lt;br&gt;Серые контейнеры обслуживают платежи и текущие счета. В депозитном потоке они не участвуют." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d5dd;fontColor=#111827;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="24" y="980" width="2060" height="300" as="geometry"/></mxCell>
        <mxCell id="20" value="HTTPS. Каталог и заявка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#0f4c81;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="21" value="HTTPS. Ставка и заявка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#0f4c81;strokeWidth=1.5;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="22" value="Вход клиента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.5;dashed=1;dashPattern=7 4;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="23" value="Платежи и счета" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.5;dashed=1;dashPattern=7 4;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="24" value="Заявки и витрина" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#0f4c81;strokeWidth=1.5;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="25" value="Заявки и запрос ставки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="26" value="Ставки и статусы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="27" value="В АБС" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="28" value="Из outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="29" value="Вызов процедур" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#b45309;strokeWidth=1.5;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1744" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="30" value="Учёт и outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#1168bd;strokeWidth=1.5;exitX=0.15;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="18" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
