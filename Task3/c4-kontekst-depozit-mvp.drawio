        <mxCell id="9" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;[система, Delphi, Oracle]&lt;br&gt;Ставки, подтверждение, депозит" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="10" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;[система]&lt;br&gt;Код и уведомления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="770" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="11" value="&lt;b&gt;Телеком-оператор&lt;/b&gt;&lt;br&gt;[внешняя система]&lt;br&gt;Доставка СМС клиенту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b7280;strokeColor=#4b5563;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1340" y="770" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="12" value="&lt;b&gt;Оператор кол-центра&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="13" value="&lt;b&gt;Сотрудник отделения&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="1040" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="14" value="&lt;b&gt;Депозитный бэк-офис&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="630" y="1040" width="250" height="64" as="geometry"/></mxCell>
        <mxCell id="15" value="&lt;b&gt;Кредитный бэк-офис&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="920" y="1040" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="16" value="&lt;b&gt;Как читать схему&lt;/b&gt;&lt;br&gt;Каналы ходят только в сервис открытия депозитов.&lt;br&gt;Сервис отдаёт заявку и запрос ставки в АБС асинхронно и забирает оттуда витрину ставок и статусы.&lt;br&gt;Прямого доступа сайта и интернет-банка к базе и API АБС в этом процессе нет.&lt;br&gt;СМС-код и СМС о ставке и открытии отправляет сервис через шлюз.&lt;br&gt;Депозит на MVP появляется после подтверждения депозитного бэк-офиса в АБС.&lt;br&gt;Новый клиент после звонка проходит идентификацию в отделении по той же заявке.&lt;br&gt;Кредитный конвейер и скоринг в этот MVP не входят." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d5dd;fontColor=#111827;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="1600" height="190" as="geometry"/></mxCell>
        <mxCell id="17" value="Заявка на депозит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Arial;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;strokeColor=#083f75;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
