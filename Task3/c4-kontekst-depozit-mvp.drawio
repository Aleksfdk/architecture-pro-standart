        <mxCell id="7" value="&lt;b&gt;Сервис открытия депозитов&lt;/b&gt;&lt;br&gt;[система, новая]&lt;br&gt;ASP.NET Core, MS SQL&lt;br&gt;Заявки, витрина ставок, СМС-код" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f4c81;strokeColor=#0b3a66;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="400" height="160" as="geometry"/></mxCell>
