        <mxCell id="2" value="&lt;b&gt;C4. Контекст. MVP открытия депозитов&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontColor=#111827;fontSize=20;fontFamily=Arial;align=left;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="1400" height="32" as="geometry"/></mxCell>
        <mxCell id="3" value="&lt;b&gt;Новый клиент&lt;/b&gt;&lt;br&gt;[человек]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083f75;strokeColor=#083f75;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="240" height="64" as="geometry"/></mxCell>
