        <mxCell id="5" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;[система, PHP и React.js]&lt;br&gt;Каталог и заявка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="280" height="120" as="geometry"/></mxCell>
